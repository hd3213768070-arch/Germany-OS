---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CategoryCard from "../../components/CategoryCard.astro";
import { categoriesFor, getPublishedArticles } from "../../lib/content";
const categories = categoriesFor(await getPublishedArticles());
---
<BaseLayout title="分类浏览" description="按主题浏览 Germany OS 的德国生活、学习与工作知识库。">
  <Header />
  <main class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <p class="text-sm font-bold tracking-[0.16em] text-moss">KNOWLEDGE MAP</p>
    <h1 class="mt-3 font-display text-5xl font-bold tracking-tight">分类浏览</h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">从具体问题开始，进入对应的德国知识主题。仅展示已具备实质正文的文章。</p>
    <div class="mt-12 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">{categories.map((category) => <CategoryCard {...category} />)}</div>
  </main>
  <Footer />
</BaseLayout>

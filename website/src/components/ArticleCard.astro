---
import { articleUrl, categoryNames, type Article } from "../lib/content";
interface Props { article: Article; compact?: boolean; }
const { article, compact = false } = Astro.props;
---
<article class:list={["border-b border-line py-5", compact && "py-4"]}>
  <p class="text-xs font-semibold tracking-wide text-moss">{categoryNames[article.category] ?? article.category}</p>
  <h3 class:list={["mt-2 font-display font-bold tracking-tight text-ink", compact ? "text-lg" : "text-2xl"]}>
    <a href={articleUrl(article)} class="hover:text-moss">{article.title}</a>
  </h3>
  {!compact && <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-600">{article.description}</p>}
</article>

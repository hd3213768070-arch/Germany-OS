---
import { categoryNames } from "../lib/content";
const links = Object.entries(categoryNames);
---

<header class="sticky top-0 z-40 border-b border-line/80 bg-paper/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 lg:px-8">
    <a href="/" class="group flex items-center gap-3" aria-label="Germany OS 首页">
      <span class="grid size-9 place-items-center rounded-xl bg-forest font-display text-lg font-bold text-white">G</span>
      <span>
        <span class="block text-sm font-bold tracking-[0.16em] text-forest">GERMANY OS</span>
        <span class="block text-xs text-slate-500">德国生活与学习知识库</span>
      </span>
    </a>
    <nav class="hidden items-center gap-6 text-sm font-medium lg:flex" aria-label="主导航">
      <a href="/categories/" class="hover:text-moss">分类浏览</a>
      <a href="/guides/" class="hover:text-moss">办事指南</a>
      <a href="/about/" class="hover:text-moss">关于项目</a>
    </nav>
    <a href="/search/" class="rounded-full border border-line px-4 py-2 text-sm font-medium text-forest hover:border-moss hover:bg-sand">搜索知识库 <span aria-hidden="true">⌘K</span></a>
  </div>
  <nav class="flex gap-4 overflow-x-auto border-t border-line/60 px-5 py-2 text-xs text-slate-600 lg:hidden" aria-label="分类导航">
    {links.map(([id, label]) => <a href={`/categories/${id}/`} class="shrink-0 hover:text-moss">{label}</a>)}
  </nav>
</header>

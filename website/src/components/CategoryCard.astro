---
interface Props { id: string; title: string; description: string; count: number; }
const { id, title, description, count } = Astro.props;
---
<a href={`/categories/${id}/`} class="group flex min-h-40 flex-col justify-between rounded-2xl border border-line bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-moss/50 hover:shadow-lg">
  <div>
    <p class="text-sm font-semibold text-moss">{String(count).padStart(2, "0")} 篇已发布</p>
    <h2 class="mt-3 text-xl font-bold tracking-tight text-ink">{title}</h2>
    <p class="mt-2 text-sm leading-6 text-slate-600">{description}</p>
  </div>
  <span class="mt-5 text-sm font-semibold text-forest group-hover:text-moss">浏览知识 →</span>
</a>
